// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}



model Pessoa {
  id            Int    @id @default(autoincrement())
  cpf           String 
  nome          String
}


model professor {
  id            Int     @id @default(autoincrement())
  especialidade String  
  contato       String
}

model Aluno {
  id               Int        @id @default(autoincrement())
  cpf              String     @unique
  nome             String
  idade            Int
  peso             Float
  altura           Float
  valorMensalidade Float
  graduacao        String
  evolucoes        Evolucao[]
  aulaParticular   aulaParticular[]

}


model Evolucao {
  id            Int      @id @default(autoincrement())
  pesoAtual     Float
  bioimpedancia Float
  dataAvaliacao DateTime
  alunoId       Int
  aluno         Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
}

enum StatusAulaParticular {
  AGENDADA
  CONCLUIDA
  CANCELADA
}

model aulaParticular {
  id                 Int @id @default(autoincrement())
  data               String
  horario            String
  alunoId            Int
  aluno              Aluno @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  status             StatusAulaParticular @default(AGENDADA)
  presenca           Boolean?

  recorrenciaId      Int?
  recorrencia        RecorrenciaAulaParticular? @relation(fields: [recorrenciaId], references: [id])

  @@index([alunoId, data, horario])
  @@index([recorrenciaId])
}

model RecorrenciaAulaParticular {
  id         Int      @id @default(autoincrement())
  alunoId    Int
  dataInicio String
  dataFim    String
  diasSemana Int[]
  horario    String

  aulas      aulaParticular[]
}

model Aula {
  id            Int      @id @default(autoincrement())
  dataAula      DateTime 
  horarioIni    String
  duracaomin    Int
  presente      Boolean  @default(true)
  obsevacao     String
}


model modalidade {
  id            Int      @id @default(autoincrement())
  nome          String
}


model horario {
  id            Int      @id @default(autoincrement())
  diaSemana     String   
  horainicio    String
  horafim       String
  limitteAluns  Int
}



