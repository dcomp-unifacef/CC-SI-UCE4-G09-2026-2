// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Pessoa {
  id   Int    @id @default(autoincrement())
  cpf  String @unique
  nome String
}

model Professor {
  id                Int              @id @default(autoincrement())
  cpf               String           @unique
  nome              String
  especialidade     String
  contato           String
  //relação com aula
  aulas             Aula[]
  //descomentar quando der merge:
  aulasParticulares AulaParticular[]
}

model Aula {
  id             Int             @id @default(autoincrement())
  data           DateTime
  horarioInicio  String
  duracaoMinutos Int
  presente       Boolean         @default(true)
  observacao     String
  professorId    Int
  professor      Professor       @relation(fields: [professorId], references: [id])
  //descomentar quando der merge :
  modalidadeId   Int
  modalidade     Modalidade      @relation(fields: [modalidadeId], references: [id])
  aulaParticular AulaParticular?
  turmaId        Int
  turma          Turma           @relation(fields: [turmaId], references: [id])
}

model Aluno {
  id                   Int                   @id @default(autoincrement())
  cpf                  String                @unique
  nome                 String
  idade                Int
  peso                 Float
  altura               Float
  valorMensalidade     Float
  graduacao            String
  evolucoes            Evolucao[]
  aulaParticular       AulaParticular[]
  turmas               Turma[]
  financeiros          Financeiro[]
  notificacoes         Notificacao[]
  presencas            Presenca[]
  inscricoesCampeonato InscricaoCampeonato[]
}

model Presenca {
  id      Int      @id @default(autoincrement())
  data    DateTime
  hora    String
  foto    String
  alunoId Int
  aluno   Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  @@unique([alunoId, data])
}

model Campeonato {
  id          Int                   @id @default(autoincrement())
  nome        String                @unique
  data        DateTime
  local       String
  locomocao   String
  valores     Float
  descricao   String
  pesosDeLuta String[]
  inscricoes  InscricaoCampeonato[]
}

model InscricaoCampeonato {
  id           Int        @id @default(autoincrement())
  pesoDeLuta   String
  campeonatoId Int
  alunoId      Int
  campeonato   Campeonato @relation(fields: [campeonatoId], references: [id], onDelete: Cascade)
  aluno        Aluno      @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  @@unique([campeonatoId, alunoId])
}

model Evolucao {
  id            Int      @id @default(autoincrement())
  pesoAtual     Float
  bioimpedancia Float
  dataAvaliacao DateTime
  alunoId       Int
  aluno         Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
}

enum StatusAulaParticular {
  AGENDADA
  CONCLUIDA
  CANCELADA
}

model AulaParticular {
  id      Int    @id @default(autoincrement())
  data    String
  horario String
  alunoId Int
  aluno   Aluno  @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  professorId Int
  professor   Professor @relation(fields: [professorId], references: [id])

  aulaId Int  @unique
  aula   Aula @relation(fields: [aulaId], references: [id])

  status   StatusAulaParticular @default(AGENDADA)
  presenca Boolean?

  recorrenciaId Int?
  recorrencia   RecorrenciaAulaParticular? @relation(fields: [recorrenciaId], references: [id])

  @@index([alunoId, data, horario])
  @@index([recorrenciaId])
}

model RecorrenciaAulaParticular {
  id         Int    @id @default(autoincrement())
  alunoId    Int
  dataInicio String
  dataFim    String
  diasSemana Int[]
  horario    String

  aulas AulaParticular[]
}

model Horario {
  id           Int    @id @default(autoincrement())
  diaSemana    String
  horainicio   String
  horafim      String
  limitteAluns Int
}

model Modalidade {
  id      Int    @id @default(autoincrement())
  nome    String
  turmaId Int
  turma   Turma  @relation(fields: [turmaId], references: [id])
  aulas   Aula[]
}

model Turma {
  id          Int          @id @default(autoincrement())
  nome        String
  alunos      Aluno[]
  aulas       Aula[]
  modalidades Modalidade[]
}

model Financeiro {
  id            Int    @id @default(autoincrement())
  valor         Float
  tipoDePlano   String
  desconto      Float
  taxaExtra     Float
  dataPagamento String
  alunoId       Int
  aluno         Aluno  @relation(fields: [alunoId], references: [id], onDelete: Cascade)
}

model Notificacao {
  id              Int    @id @default(autoincrement())
  tipoNotificacao String
  mensagem        String
  alunoId         Int
  aluno           Aluno  @relation(fields: [alunoId], references: [id], onDelete: Cascade)
}
