// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}





model Pessoa {
  id            Int    @id @default(autoincrement())
  cpf           String @unique
  nome          String
}


model Professor {
  id                  Int     @id @default(autoincrement())
  cpf                 String  @unique
  nome                String  
  especialidade       String  
  contato             String
  //relação com aula
  aulas         Aula[]
  //descomentar quando der merge:
  //aulasParticulares AulaParticular[]
} 


model Aula {
  id             Int      @id @default(autoincrement())
  data           DateTime 
  horarioInicio  String
  duracaoMinutos Int
  presente       Boolean  @default(true)
  observacao     String
  professorId    Int
  professor      Professor @relation(fields: [professorId], references: [id])
  //descomentar quando der merge :
  //modalidadeId Int 
  //modalidade   Modalidade @relation(fields: [modalidadeId], references: [id]
  //aulaParticular AulaParticular? 
}



model Aluno {
  id               Int        @id @default(autoincrement())
  cpf              String     @unique
  nome             String
  idade            Int
  peso             Float
  altura           Float
  valorMensalidade Float
  graduacao        String
  evolucoes        Evolucao[]
  aulaParticular   AulaParticular[]

}


model Evolucao {
  id            Int      @id @default(autoincrement())
  pesoAtual     Float
  bioimpedancia Float
  dataAvaliacao DateTime
  alunoId       Int
  aluno         Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
}


model AulaParticular {
  id            Int     @id @default(autoincrement())
  data          String
  horario       String
  alunoId       Int
  aluno         Aluno   @relation(fields: [alunoId], references: [id], onDelete: Cascade)
}


model Modalidade {
  id            Int      @id @default(autoincrement())
  nome          String
}


model Horario {
  id            Int      @id @default(autoincrement())
  diaSemana     String   
  horainicio    String
  horafim       String
  limitteAluns  Int
}



