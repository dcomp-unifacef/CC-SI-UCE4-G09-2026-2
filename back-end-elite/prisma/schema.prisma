generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StatusAluno {
  ATIVO
  INADIMPLENTE
  INATIVO
}

enum StatusAulaParticular {
  AGENDADA
  CONCLUIDA
  CANCELADA
}

model Pessoa {
  id   Int    @id @default(autoincrement())
  cpf  String @unique
  nome String
}

model Professor {
  id                Int              @id @default(autoincrement())
  cpf               String           @unique
  nome              String
  especialidade     String
  contato           String
  ativo             Boolean          @default(true)
  aulas             Aula[]
  aulasParticulares AulaParticular[]
}

model Aluno {
  id                   Int                   @id @default(autoincrement())
  cpf                  String                @unique
  nome                 String
  idade                Int
  peso                 Float
  altura               Float
  valorMensalidade     Float
  graduacao            String
  email                String?
  telefone             String?
  dataMatricula        String?
  streak               Int                   @default(0)
  status               StatusAluno           @default(ATIVO)
  modalidades          String[]
  evolucoes            Evolucao[]
  aulaParticular       AulaParticular[]
  turmas               Turma[]
  financeiros          Financeiro[]
  notificacoes         Notificacao[]
  presencas            Presenca[]
  inscricoesCampeonato InscricaoCampeonato[]
}

model Aula {
  id             Int             @id @default(autoincrement())
  data           DateTime
  horarioInicio  String
  duracaoMinutos Int
  capacidade     Int             @default(20)
  diaSemana      Int             @default(1)
  presente       Boolean         @default(true)
  observacao     String          @default("")
  professorId    Int
  professor      Professor       @relation(fields: [professorId], references: [id])
  modalidadeId   Int
  modalidade     Modalidade      @relation(fields: [modalidadeId], references: [id])
  aulaParticular AulaParticular?
  turmaId        Int
  turma          Turma           @relation(fields: [turmaId], references: [id])
}

model Presenca {
  id      Int      @id @default(autoincrement())
  data    DateTime
  hora    String
  foto    String   @default("")
  alunoId Int
  aluno   Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  @@unique([alunoId, data])
}

model Campeonato {
  id          Int                   @id @default(autoincrement())
  nome        String                @unique
  data        DateTime
  local       String
  locomocao   String
  valores     Float
  descricao   String
  pesosDeLuta String[]
  inscricoes  InscricaoCampeonato[]
}

model InscricaoCampeonato {
  id           Int        @id @default(autoincrement())
  pesoDeLuta   String
  campeonatoId Int
  alunoId      Int
  campeonato   Campeonato @relation(fields: [campeonatoId], references: [id], onDelete: Cascade)
  aluno        Aluno      @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  @@unique([campeonatoId, alunoId])
}

model Evolucao {
  id            Int      @id @default(autoincrement())
  pesoAtual     Float
  bioimpedancia Float
  dataAvaliacao DateTime
  alunoId       Int
  aluno         Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
}

model AulaParticular {
  id      Int    @id @default(autoincrement())
  data    String
  horario String
  alunoId Int
  aluno   Aluno  @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  professorId Int
  professor   Professor @relation(fields: [professorId], references: [id])

  aulaId Int  @unique
  aula   Aula @relation(fields: [aulaId], references: [id])

  status   StatusAulaParticular @default(AGENDADA)
  presenca Boolean?

  recorrenciaId Int?
  recorrencia   RecorrenciaAulaParticular? @relation(fields: [recorrenciaId], references: [id])

  @@index([alunoId, data, horario])
  @@index([recorrenciaId])
}

model RecorrenciaAulaParticular {
  id         Int    @id @default(autoincrement())
  alunoId    Int
  dataInicio String
  dataFim    String
  diasSemana Int[]
  horario    String

  aulas AulaParticular[]
}

model Horario {
  id           Int    @id @default(autoincrement())
  diaSemana    String
  horainicio   String
  horafim      String
  limitteAluns Int
}

model Modalidade {
  id      Int    @id @default(autoincrement())
  nome    String
  turmaId Int?
  turma   Turma? @relation(fields: [turmaId], references: [id])
  aulas   Aula[]
}

model Turma {
  id          Int          @id @default(autoincrement())
  nome        String
  alunos      Aluno[]
  aulas       Aula[]
  modalidades Modalidade[]
}

model Financeiro {
  id             Int      @id @default(autoincrement())
  valor          Float
  tipoDePlano    String   @default("")
  desconto       Float    @default(0)
  taxaExtra      Float    @default(0)
  dataPagamento  String   @default("")
  // Campos adicionados para integração com a UI de pagamentos
  forma          String   @default("Pix")
  status         String   @default("aberto")
  referenciaMes  String   @default("")
  observacao     String   @default("")
  alunoId        Int
  aluno          Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
}

model Notificacao {
  id              Int      @id @default(autoincrement())
  tipoNotificacao String
  mensagem        String
  lida            Boolean  @default(false)
  data            DateTime @default(now())
  alunoId         Int
  aluno           Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
}
